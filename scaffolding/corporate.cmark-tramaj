=base:library.tramaj-lib hero
.div(class: "hero",
  .h1($ctx.title),
  .p(class: "hero-subtitle", $ctx.subtitle),
  .div(class: "hero-actions",
    map($ctx.actions, (a) =>
      .a(class: branch("button", eq($a.style, "secondary"), "button secondary"),
         href: $a.href,
         $a.label))),
  branch("", has($ctx, "image"),
    .img(class: "hero-image", src: $ctx.image.src, alt: $ctx.image.alt)))

=base:library.tramaj-lib feature-grid
.div(class: "feature-grid",
  map($ctx.features, (f) =>
    .div(class: "feature-card",
      .h3($f.title),
      .p($f.body))))

=base:library.tramaj-lib pricing-table
.table(class: "pricing-table",
  .thead(
    .tr(
      .th(class: "pricing-feature-header"),
      map($ctx.plans, (p) =>
        .th(class: "pricing-plan-header",
          .div(class: "pricing-plan-name", $p.name),
          .div(class: "pricing-plan-price", $p.price))))),
  .tbody(
    map($ctx.rows, (r) =>
      .tr(
        .td(class: "pricing-feature-name", $r.feature),
        map($r.values, (v) => .td(class: "pricing-value", $v))))))

=base:library.tramaj-lib cta-banner
.div(class: "cta-banner",
  id: $ctx.id,
  .h2($ctx.title),
  .p($ctx.body),
  .a(class: "button", href: $ctx.href, $ctx.label))

=base:library.tramaj-lib testimonial-strip
.div(class: "testimonial-strip",
  map($ctx.testimonials, (t) =>
    .div(class: "testimonial",
      $t.quote,
      .span(class: "testimonial-author", $t.author))))

=base:library.tramaj-lib footer-columns
.div(class: "corp-footer-columns",
  map($ctx.columns, (c) =>
    .div(class: "corp-footer-column",
      .h2($c.heading),
      .ul(map($c.links, (l) => .li(.a(href: $l.href, $l.label)))))))

=base:library.tramaj-lib split
.div(class: branch("split", has($ctx, "side"), branch("split", eq($ctx.side, "left"), "split split-image-left")),
  .div(class: "split-text",
    .h2($ctx.title),
    .p($ctx.body)),
  .img(class: "split-image", src: $ctx.image.src, alt: $ctx.image.alt))

=base:library.tramaj-lib contact-details
.div(class: "contact-details",
  branch("", has($ctx.details, "address"),
    .div(class: "contact-block contact-address",
      .h3("Address"),
      .p(map($ctx.details.address, (line) => .span(class: "contact-line", $line))))),
  branch("", has($ctx.details, "phone"),
    .div(class: "contact-block contact-phone",
      .h3("Phone"),
      .p(.a(href: "tel:" <> $ctx.details.phone.number, $ctx.details.phone.label)))),
  branch("", has($ctx.details, "email"),
    .div(class: "contact-block contact-email",
      .h3("Email"),
      .p(.a(href: "mailto:" <> $ctx.details.email, $ctx.details.email)))),
  branch("", has($ctx.details, "hours"),
    .div(class: "contact-block contact-hours",
      .h3("Opening hours"),
      .dl(map($ctx.details.hours, (h) => .div(.dt($h.days), .dd($h.hours)))))))

=base:library.tramaj-lib logo-strip
.div(class: "logo-strip",
  map($ctx.logos, (l) =>
    branch(.img(src: $l.src, alt: $l.alt), has($l, "href"),
      .a(href: $l.href, .img(src: $l.src, alt: $l.alt)))))
