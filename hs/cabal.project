packages: .

with-compiler: ghc-9.10.3

-- Development builds keep warnings fatal (the flag is off by default so that
-- the Hackage release does not break on newer GHCs).
package kitchen-sink
    flags: +werror +purescript-bridge

-- prodapi-* and acme-not-a-joke* on Hackage still cap aeson < 2.3,
-- crypton < 1.1, tls < 2.5 (and, through them, jose, crypton-x509,
-- http-client-tls). kitchen-sink itself targets aeson 2.3 / crypton 2.x /
-- tls 2.4+; lift the upstream caps here until those packages are released
-- with wider bounds.
allow-newer:
    prodapi-core:*
  , prodapi-web:*
  , prodapi-proxy:*
  , acme-not-a-joke:*
  , acme-not-a-joke-wai:*
  , acme-not-a-joke-warp:*
