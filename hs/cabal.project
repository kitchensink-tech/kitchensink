packages: .

with-compiler: ghc-9.10.3

-- prodapi-proxy and tramaj-hs pin an exact `base` upper bound matching
-- GHC 9.8's base; both build and run fine against GHC 9.10's base, the
-- bound is just stale. See CLAUDE.md for the GHC version this project
-- targets.
allow-newer: prometheus-client:*
           , prodapi-proxy:base
           , tramaj-hs:base

source-repository-package
    type: git
    location: https://github.com/lucasdicioccio/prodapi.git
    tag: 8431beee54673b05adcbefc887410f166006f5b4
    subdir: prodapi-core

source-repository-package
    type: git
    location: https://github.com/lucasdicioccio/prodapi.git
    tag: 8431beee54673b05adcbefc887410f166006f5b4
    subdir: prodapi-web

source-repository-package
    type: git
    location: https://github.com/lucasdicioccio/prodapi.git
    tag: 8431beee54673b05adcbefc887410f166006f5b4
    subdir: prodapi-proxy

source-repository-package
    type: git
    location: https://github.com/lucasdicioccio/purescript-bridge.git
    tag: 76d8b4c53b0bbfd609a327857b1e09657cf1fc23

-- Backend for the tramaj-json/tramaj-doc/tramaj-lib sections. Formerly
-- "templating-lang" / "templating-hs"; renamed to "tramaj" / "tramaj-hs".
source-repository-package
    type: git
    location: https://github.com/lucasdicioccio/tramaj.git
    tag: 2a8d80492fd1b39b4a41f5f3991de9d21075b014
    subdir: tramaj-hs

-- Use iand675's fork which has GHC 9.8 fixes
source-repository-package
    type: git
    location: https://github.com/fimad/prometheus-haskell
    tag: 55cae43af452a57afaafb1ced9551b716202a59a
    subdir: prometheus-client

